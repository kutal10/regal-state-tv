---
import Layout from '../layouts/Layout.astro';
import Gate from '../components/Gate.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import {
	site,
	artifacts,
	ideas,
	getChronologicalArtifacts,
	type ArtifactState,
} from '../data/site';

type FilterId = 'all' | ArtifactState;

const chronological = getChronologicalArtifacts();

const tiles = [
	...chronological.map((artifact) => ({
		id: artifact.slug,
		title: artifact.title,
		texture: artifact.texture,
		state: artifact.state,
		href: `/watch/${artifact.slug}`,
		seed: false,
	})),
	...ideas.map((idea) => ({
		id: idea.slug,
		title: idea.title,
		texture: idea.texture,
		state: 'idea' as ArtifactState,
		href: undefined,
		seed: true,
	})),
];

const filters: { id: FilterId; label: string; count: number }[] = [
	{ id: 'all', label: 'All', count: tiles.length },
	{ id: 'released', label: 'Released', count: artifacts.filter((a) => a.state === 'released').length },
	{ id: 'rough', label: 'Rough', count: artifacts.filter((a) => a.state === 'rough').length },
	{ id: 'idea', label: 'Ideas', count: ideas.length },
];
---

<Layout title={`Archive — ${site.name}`}>
	<Gate email={site.email} />

	<div class="page">
		<SiteHeader current="archive" />

		<main class="sheet">
			<nav class="filters" aria-label="Filter the archive">
				{
					filters.map((filter) => (
						<button
							type="button"
							class="filter"
							data-filter={filter.id}
							aria-pressed={filter.id === 'all' ? 'true' : 'false'}
						>
							{filter.label}
							<span class="filter-count">{filter.count}</span>
						</button>
					))
				}
			</nav>

			<ul class="grid">
				{
					tiles.map((tile) => (
						<li
							class:list={['tile', tile.seed && 'tile-seed']}
							data-state={tile.state}
							style={`--texture: url('/textures-lowres/${tile.texture}.webp')`}
						>
							{tile.href ? (
								<a class="tile-link" href={tile.href}>
									<span class="tile-plate" aria-hidden="true" />
									<span class="tile-title">{tile.title}</span>
								</a>
							) : (
								<div class="tile-link">
									<span class="tile-plate" aria-hidden="true" />
									<span class="tile-title">{tile.title}</span>
								</div>
							)}
						</li>
					))
				}
			</ul>
		</main>

		<SiteFooter email={site.email} instagram={site.instagram} youtube={site.youtube} />
	</div>
</Layout>

<script>
	const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
	const tiles = document.querySelectorAll<HTMLElement>('[data-state]');

	buttons.forEach((button) => {
		button.addEventListener('click', () => {
			const filter = button.dataset.filter;

			buttons.forEach((other) => other.setAttribute('aria-pressed', String(other === button)));
			tiles.forEach((tile) => {
				const show = filter === 'all' || tile.dataset.state === filter;
				tile.hidden = !show;
			});
		});
	});
</script>

<style>
	.sheet {
		display: grid;
		grid-template-rows: auto minmax(0, 1fr);
		min-height: 0;
	}

	.filters {
		display: flex;
		align-items: baseline;
		gap: clamp(1rem, 2.4vw, 2.2rem);
		padding: 0 clamp(16px, 3vw, 40px) clamp(12px, 1.8vw, 18px);
		border-bottom: 1px solid var(--hairline);
	}

	.filter {
		display: inline-flex;
		align-items: baseline;
		gap: 0.45rem;
		padding: 0 0 0.4rem;
		border: 0;
		border-bottom: 1px solid transparent;
		background: none;
		font-family: var(--mono);
		font-size: 0.68rem;
		letter-spacing: 0.13em;
		text-transform: uppercase;
		color: var(--soft);
		cursor: pointer;
		transition: color 160ms ease;
	}

	.filter:hover {
		color: var(--ink);
	}

	.filter[aria-pressed='true'] {
		color: var(--ink);
		border-bottom-color: var(--accent);
	}

	.filter-count {
		font-size: 0.6rem;
		color: var(--soft);
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: clamp(10px, 1.4vw, 18px);
		margin: 0;
		padding: clamp(14px, 2vw, 22px) clamp(16px, 3vw, 40px) clamp(14px, 2vw, 22px);
		list-style: none;
		min-height: 0;
		overflow-y: auto;
		overscroll-behavior: contain;
		scrollbar-width: thin;
		scrollbar-color: var(--hairline) transparent;
	}

	.tile {
		min-width: 0;
	}

	.tile-link {
		display: grid;
		grid-template-rows: minmax(0, 1fr) auto;
		height: 100%;
		gap: 0.7rem;
	}

	.tile-plate {
		display: block;
		min-height: clamp(120px, 22vh, 260px);
		background: var(--texture, #1a1512) center / cover no-repeat;
		filter: saturate(0.72);
		transition: filter 240ms ease;
	}

	.tile-link:hover .tile-plate {
		filter: saturate(1);
	}

	.tile-title {
		font-size: clamp(0.95rem, 1.1vw, 1.1rem);
		line-height: 1.2;
		color: var(--muted);
		transition: color 160ms ease;
	}

	a.tile-link:hover .tile-title {
		color: var(--accent);
	}

	.tile-seed .tile-plate {
		filter: saturate(0.5) contrast(0.92);
		opacity: 0.72;
	}

	.tile-seed .tile-title {
		font-style: italic;
		color: var(--soft);
	}

	@media (max-width: 1100px) {
		.grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}

	@media (max-width: 760px) {
		.grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
</style>
