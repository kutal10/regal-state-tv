---
import Layout from '../../layouts/Layout.astro';
import Gate from '../../components/Gate.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import YouTubeEmbed from '../../components/YouTubeEmbed.astro';
import {
	site,
	inquiries,
	artifacts,
	getArtifactBySlug,
	type Artifact,
	type Inquiry,
} from '../../data/site';

export function getStaticPaths() {
	return artifacts.map((artifact) => ({
		params: { slug: artifact.slug },
		props: { artifact },
	}));
}

interface Props {
	artifact: Artifact;
}

const { artifact } = Astro.props;

function formatDate(date: string) {
	return new Date(`${date}T00:00:00`).toLocaleDateString('en-GB', {
		month: 'short',
		year: 'numeric',
	});
}

const stateLabel =
	artifact.state === 'rough' ? 'rough cut' : artifact.state === 'idea' ? 'seed' : artifact.state;

const inquiryList = artifact.questions
	.map((slug) => inquiries.find((inquiry) => inquiry.slug === slug))
	.filter((inquiry): inquiry is Inquiry => Boolean(inquiry));

const primaryInquiry = inquiryList[0];

const siblingMap = new Map<string, Artifact>();
for (const inquiry of inquiryList) {
	for (const slug of inquiry.artifactSlugs) {
		if (slug === artifact.slug) continue;
		const sibling = getArtifactBySlug(slug);
		if (sibling) siblingMap.set(slug, sibling);
	}
}
const siblings = [...siblingMap.values()];

const openThreads = [...new Set(inquiryList.flatMap((inquiry) => inquiry.openThreads))];

const contradicts = artifact.contradicts
	? getArtifactBySlug(artifact.contradicts.slug)
	: undefined;

const notes = [
	{ label: 'Summary', body: artifact.summary },
	{ label: 'Triggered by', body: artifact.triggeredBy },
	...(artifact.nextMove ? [{ label: 'Next move', body: artifact.nextMove }] : []),
];

const hasNotes =
	notes.length > 0 ||
	artifact.references.length > 0 ||
	(artifact.rejected?.length ?? 0) > 0 ||
	openThreads.length > 0 ||
	Boolean(contradicts);
---

<Layout title={`${artifact.title} — ${site.name}`} description={artifact.summary}>
	<Gate email={site.email} />

	<div class="page">
		<SiteHeader current="watch" />

		<main class="stage" data-artifact={artifact.slug}>
			<div class="stage-head">
				<h1 class="work-title">{artifact.title}</h1>
				<p class="work-meta mono">
					{stateLabel} · {artifact.duration} · {formatDate(artifact.date)}
				</p>
			</div>

			<div class="work-frame">
				{artifact.youtubeId ? (
					<YouTubeEmbed id={artifact.youtubeId} title={artifact.title} />
				) : (
					<div class="panel" style={`--texture: url('/textures-lowres/${artifact.texture}.webp')`}>
						<span class="panel-note mono">{artifact.kind}</span>
					</div>
				)}
			</div>

			<div class="stage-foot">
				{primaryInquiry && (
					<a class="back-link" href={`/questions/#q-${primaryInquiry.slug}`}>
						{primaryInquiry.question}
					</a>
				)}

				<div class="stage-actions">
					{contradicts && (
						<p class="tension mono">
							in tension with{' '}
							<a href={`/watch/${contradicts.slug}`}>{contradicts.title} →</a>
						</p>
					)}
					<button class="seen-toggle mono" type="button" id="seen-toggle" aria-pressed="false">
						Seen
					</button>
					{hasNotes && (
						<button class="notes-toggle mono" type="button" id="notes-toggle" aria-expanded="false">
							Notes
						</button>
					)}
				</div>
			</div>
		</main>

		<SiteFooter email={site.email} instagram={site.instagram} youtube={site.youtube} />
	</div>

	{hasNotes && (
		<div class="notes" id="notes" hidden>
			<div class="notes-bar">
				<p class="mono">{artifact.title}</p>
				<button class="notes-close mono" type="button" id="notes-close" aria-label="Close notes">
					Close
				</button>
			</div>

			<div class="notes-body">
				<div class="notes-col">
					{notes.map((note) => (
						<div class="note-block">
							<p class="mono note-label">{note.label}</p>
							<p class="note-copy">{note.body}</p>
						</div>
					))}
				</div>

				<div class="notes-col">
					{contradicts && (
						<div class="note-block">
							<p class="mono note-label">In argument with</p>
							<a class="note-link" href={`/watch/${contradicts.slug}`}>
								{contradicts.title} →
							</a>
						</div>
					)}

					{artifact.references.length > 0 && (
						<div class="note-block">
							<p class="mono note-label">References</p>
							<ul class="note-list">
								{artifact.references.map((reference) => (
									<li>
										{reference.label}
										<span class="note-meta mono">{reference.meta}</span>
									</li>
								))}
							</ul>
						</div>
					)}
				</div>

				<div class="notes-col">
					{openThreads.length > 0 && (
						<div class="note-block">
							<p class="mono note-label">Still open</p>
							<ul class="note-list">
								{openThreads.map((thread) => (
									<li>{thread}</li>
								))}
							</ul>
						</div>
					)}

					{artifact.rejected && artifact.rejected.length > 0 && (
						<div class="note-block">
							<p class="mono note-label">Considered, rejected</p>
							<ul class="note-list note-list-rejected">
								{artifact.rejected.map((line) => (
									<li>{line}</li>
								))}
							</ul>
						</div>
					)}

					{siblings.length > 0 && (
						<div class="note-block">
							<p class="mono note-label">Also here</p>
							<ul class="note-list">
								{siblings.map((sibling) => (
									<li>
										<a class="note-link" href={`/watch/${sibling.slug}`}>
											{sibling.title}
										</a>
									</li>
								))}
							</ul>
						</div>
					)}
				</div>
			</div>
		</div>
	)}
</Layout>

<script>
	import { loadProgress, mark, toggle } from '../../lib/progress';

	const toggleButton = document.getElementById('notes-toggle') as HTMLButtonElement | null;
	const notes = document.getElementById('notes') as HTMLElement | null;
	const close = document.getElementById('notes-close') as HTMLButtonElement | null;

	function setNotes(open: boolean) {
		if (!toggleButton || !notes) return;
		notes.hidden = !open;
		toggleButton.setAttribute('aria-expanded', String(open));
		if (open) close?.focus();
		else toggleButton.focus();
	}

	toggleButton?.addEventListener('click', () => setNotes(true));
	close?.addEventListener('click', () => setNotes(false));

	const slug = document.querySelector<HTMLElement>('[data-artifact]')?.dataset.artifact;

	if (slug) {
		mark('visited', slug);

		document.addEventListener('video:play', () => mark('played', slug));

		const seenToggle = document.getElementById('seen-toggle') as HTMLButtonElement | null;
		const seen = loadProgress().seen.includes(slug);
		seenToggle?.setAttribute('aria-pressed', String(seen));

		seenToggle?.addEventListener('click', () => {
			const pressed = seenToggle.getAttribute('aria-pressed') === 'true';
			toggle('seen', slug);
			seenToggle.setAttribute('aria-pressed', String(!pressed));
		});
	}

	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape' && notes && !notes.hidden) setNotes(false);
	});
</script>

<style>
	.stage {
		display: grid;
		grid-template-rows: auto minmax(0, 1fr) auto;
		gap: clamp(0.8rem, 1.6vh, 1.4rem);
		min-height: 0;
		padding: 0 clamp(16px, 3vw, 40px) clamp(0.8rem, 1.6vh, 1.2rem);
	}

	.stage-head {
		display: grid;
		gap: 0.45rem;
		justify-items: center;
		text-align: center;
	}

	.work-title {
		margin: 0;
		max-width: 30ch;
		font-size: clamp(1.5rem, 2.6vw, 2.5rem);
		font-weight: 300;
		line-height: 1.04;
		letter-spacing: -0.025em;
		text-wrap: balance;
	}

	.work-meta {
		margin: 0;
		color: var(--soft);
	}

	.work-frame {
		min-height: 0;
		display: flex;
		justify-content: center;
	}

	.work-frame :global(.embed) {
		width: auto;
		height: 100%;
		max-width: 100%;
		aspect-ratio: 16 / 9;
	}

	.panel {
		height: 100%;
		width: auto;
		max-width: 100%;
		aspect-ratio: 16 / 9;
		display: grid;
		place-items: center;
		background: var(--texture, #1a1512) center / cover no-repeat;
		filter: saturate(0.7);
	}

	.panel-note {
		padding: 0.5rem 0.9rem;
		background: rgba(14, 11, 9, 0.86);
		color: var(--muted);
	}

	.stage-foot {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1.5rem;
		flex-wrap: wrap;
	}

	.back-link {
		font-size: 1rem;
		font-style: italic;
		color: var(--muted);
		max-width: 52ch;
		transition: color 160ms ease;
	}

	.back-link:hover {
		color: var(--accent);
	}

	.stage-actions {
		display: flex;
		align-items: baseline;
		gap: 1.4rem;
		margin-left: auto;
	}

	.tension {
		margin: 0;
		color: var(--accent);
	}

	.tension a {
		color: var(--accent);
		transition: color 160ms ease;
	}

	.tension a:hover {
		color: var(--accent-ink);
	}

	.notes-toggle,
	.notes-close,
	.seen-toggle {
		background: none;
		border: 0;
		padding: 0;
		font: inherit;
		cursor: pointer;
		color: var(--muted);
		border-bottom: 1px solid var(--hairline-strong);
		padding-bottom: 0.15rem;
		transition: color 160ms ease;
	}

	.notes-toggle:hover,
	.notes-close:hover,
	.seen-toggle:hover {
		color: var(--ink);
	}

	.seen-toggle {
		min-width: 4.2rem;
		text-align: center;
	}

	.seen-toggle[aria-pressed='true'] {
		color: var(--accent-ink);
		border-bottom: 1px solid var(--accent-ink);
	}

	.notes {
		position: fixed;
		inset: 0;
		z-index: 50;
		display: grid;
		grid-template-rows: auto minmax(0, 1fr);
		background: rgba(10, 8, 7, 0.96);
		backdrop-filter: blur(6px);
		-webkit-backdrop-filter: blur(6px);
	}

	.notes[hidden] {
		display: none;
	}

	.notes-bar {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		padding: clamp(14px, 2vw, 22px) clamp(16px, 3vw, 40px);
		border-bottom: 1px solid var(--hairline);
		color: var(--soft);
	}

	.notes-body {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: clamp(1.4rem, 3vw, 3rem);
		padding: clamp(1.4rem, 3vw, 2.6rem) clamp(16px, 3vw, 40px) clamp(2rem, 4vw, 3rem);
		overflow-y: auto;
		overscroll-behavior: contain;
		scrollbar-width: thin;
		scrollbar-color: var(--hairline) transparent;
	}

	.notes-col {
		display: grid;
		align-content: start;
		gap: clamp(1.4rem, 2.6vw, 2.2rem);
	}

	.note-label {
		margin: 0 0 0.5rem;
		color: var(--soft);
	}

	.note-copy {
		margin: 0;
		font-size: 1.02rem;
		line-height: 1.5;
		color: var(--muted);
	}

	.note-list {
		margin: 0;
		padding: 0;
		list-style: none;
		color: var(--muted);
		font-size: 1.02rem;
		line-height: 1.45;
	}

	.note-list li + li {
		margin-top: 0.5rem;
	}

	.note-list-rejected {
		font-style: italic;
	}

	.note-meta {
		display: block;
		margin-top: 0.2rem;
		color: var(--soft);
	}

	.note-link {
		font-size: 1.02rem;
		color: var(--muted);
		transition: color 160ms ease;
	}

	.note-link:hover {
		color: var(--accent);
	}

	@media (max-width: 900px) {
		.page {
			height: auto;
			min-height: 100svh;
			overflow: visible;
		}

		.stage {
			overflow: visible;
		}

		.stage {
			grid-template-rows: auto auto auto;
			gap: 1.2rem;
			padding-bottom: 1.6rem;
		}

		.work-frame :global(.embed),
		.panel {
			width: 100%;
			height: auto;
		}

		.stage-foot {
			justify-content: flex-start;
		}

		.stage-actions {
			margin-left: 0;
		}

		.notes-body {
			grid-template-columns: 1fr;
		}
	}
</style>
