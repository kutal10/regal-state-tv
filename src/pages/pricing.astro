---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { site } from '../data/site';
import { pricingTiers } from '../data/pricing';
---

<Layout
	title={`Membership — ${site.name}`}
	description="Three ways to support Regal State: watch for free, join the core membership, or become a founding member."
	ungated
>
	<div class="pricing">
		<SiteHeader current="pricing" />

		<main class="pricing-main">
			<header class="intro">
				<p class="mono intro-kicker">Membership</p>
				<h1 class="intro-title">Pick Your Level of Depth</h1>
				<p class="intro-lede">
					Free essays for everyone. Extended cuts, raw research, and private Q&As for members.
				</p>
			</header>

			<ul class="tiers">
				{
					pricingTiers.map((tier) => (
						<li class:list={['tier', tier.featured && 'tier-featured']}>
							<div class="tier-head">
								<h2 class="tier-name">{tier.name}</h2>
								{tier.limited && <span class="mono tier-limited">{tier.limited}</span>}
							</div>

							<p class="tier-price">
								<span class="tier-amount">{tier.price}</span>
								{tier.priceNote && <span class="mono tier-note">{tier.priceNote}</span>}
							</p>

							<ul class="tier-features">
								{tier.features.map((feature) => (
									<li>{feature}</li>
								))}
							</ul>

							{tier.optin ? (
								<form class="tier-optin" data-optin>
									<p class="tier-optin-line">{tier.optin.line}</p>
									<input
										type="email"
										name="email"
										required
										placeholder={tier.optin.placeholder}
										autocomplete="email"
										aria-label="Email address"
									/>
									<button type="submit" class="mono tier-optin-submit">
										{tier.optin.button}
									</button>
									<p class="tier-optin-status mono" data-optin-status hidden>
										Access unlocked. Check your inbox for the vault link.
									</p>
								</form>
							) : (
								tier.cta && (
									<a
										class="tier-cta mono"
										href={tier.cta.href}
										target={tier.cta.href.startsWith('http') ? '_blank' : undefined}
										rel={tier.cta.href.startsWith('http') ? 'noreferrer' : undefined}
									>
										{tier.cta.label}
									</a>
								)
							)}
						</li>
					))
				}
			</ul>

			<p class="mono pricing-footnote">Prices in GBP · Cancel anytime · Founding seats are capped</p>
		</main>

		<SiteFooter email={site.email} instagram={site.instagram} youtube={site.youtube} />
	</div>
</Layout>

<script>
	document.querySelectorAll<HTMLFormElement>('[data-optin]').forEach((form) => {
		const status = form.querySelector<HTMLElement>('[data-optin-status]');
		const input = form.querySelector<HTMLInputElement>('input[name="email"]');

		form.addEventListener('submit', (event) => {
			event.preventDefault();
			if (!input?.value.trim()) return;
			if (status) status.hidden = false;
			form.querySelector('button')?.setAttribute('disabled', '');
			input.value = '';
		});
	});
</script>

<style>
	.pricing {
		display: grid;
		grid-template-rows: auto minmax(0, 1fr) auto;
		min-height: 100svh;
	}

	.pricing-main {
		display: grid;
		align-content: center;
		justify-items: center;
		gap: clamp(2rem, 4.5vh, 3.4rem);
		padding: clamp(1rem, 3vh, 2.4rem) clamp(16px, 3vw, 40px) clamp(2.4rem, 6vh, 4.4rem);
	}

	.intro {
		display: grid;
		justify-items: center;
		gap: 0.75rem;
		max-width: 62ch;
		text-align: center;
	}

	.intro-kicker {
		margin: 0;
		color: var(--accent);
	}

	.intro-title {
		margin: 0;
		font-size: clamp(2rem, 4.4vw, 3.4rem);
		font-weight: 300;
		line-height: 1.02;
		letter-spacing: -0.025em;
		text-wrap: balance;
	}

	.intro-lede {
		margin: 0;
		max-width: 54ch;
		font-size: clamp(1rem, 1.2vw, 1.1rem);
		line-height: 1.55;
		color: var(--muted);
		text-wrap: pretty;
	}

	.tiers {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: clamp(12px, 1.6vw, 22px);
		width: 100%;
		max-width: 1120px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.tier {
		position: relative;
		display: grid;
		grid-template-rows: auto auto minmax(0, 1fr) auto;
		gap: 1.1rem;
		padding: clamp(1.3rem, 2.2vw, 2rem);
		border: 1px solid var(--hairline);
		background: rgba(10, 8, 7, 0.34);
		transition: border-color 200ms ease;
	}

	.tier:hover {
		border-color: var(--hairline-strong);
	}

	.tier-featured {
		border-color: rgba(207, 116, 64, 0.52);
		background: linear-gradient(
			rgba(207, 116, 64, 0.07),
			rgba(10, 8, 7, 0.4) 42%
		);
	}

	.tier-featured:hover {
		border-color: var(--accent);
	}

	.tier-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.8rem;
	}

	.tier-limited {
		flex: none;
		padding: 0.18rem 0.5rem;
		border: 1px solid rgba(207, 116, 64, 0.44);
		color: var(--accent-ink);
		font-size: 0.56rem;
		letter-spacing: 0.1em;
	}

	.tier-name {
		margin: 0;
		font-size: clamp(1.35rem, 1.9vw, 1.75rem);
		font-weight: 400;
		line-height: 1.1;
		letter-spacing: -0.02em;
	}
	.tier-price {
		display: grid;
		gap: 0.35rem;
		margin: 0;
		padding-bottom: 1.1rem;
		border-bottom: 1px solid var(--hairline);
	}

	.tier-amount {
		font-family: var(--serif);
		font-size: clamp(1.7rem, 2.6vw, 2.3rem);
		font-weight: 300;
		line-height: 1;
		letter-spacing: -0.03em;
	}

	.tier-note {
		color: var(--soft);
		font-size: 0.6rem;
	}

	.tier-features {
		display: grid;
		align-content: start;
		gap: 0.62rem;
		margin: 0;
		padding: 0;
		list-style: none;
		font-size: 1rem;
		line-height: 1.4;
		color: var(--muted);
	}

	.tier-features li {
		position: relative;
		padding-left: 1.15rem;
	}

	.tier-features li::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0.58em;
		width: 7px;
		height: 1px;
		background: var(--hairline-strong);
	}

	.tier-featured .tier-features li::before {
		background: var(--accent);
	}

	.tier-cta {
		display: block;
		padding: 0.85rem 1rem;
		border: 1px solid var(--hairline-strong);
		color: var(--ink);
		text-align: center;
		transition:
			background-color 180ms ease,
			border-color 180ms ease,
			color 180ms ease;
	}

	.tier-optin {
		display: grid;
		align-content: start;
		gap: 0.7rem;
	}

	.tier-optin-line {
		margin: 0;
		font-size: 0.94rem;
		line-height: 1.45;
		color: var(--muted);
	}

	.tier-optin input {
		width: 100%;
		padding: 0.75rem 0.85rem;
		border: 1px solid var(--hairline-strong);
		background: rgba(14, 11, 9, 0.55);
		color: var(--ink);
		font-family: var(--mono);
		font-size: 0.78rem;
		letter-spacing: 0.04em;
	}

	.tier-optin input::placeholder {
		color: var(--soft);
	}

	.tier-optin input:focus {
		outline: none;
		border-color: var(--accent);
	}

	.tier-optin-submit {
		padding: 0.85rem 1rem;
		border: 1px solid var(--hairline-strong);
		background: transparent;
		color: var(--ink);
		cursor: pointer;
		transition:
			background-color 180ms ease,
			border-color 180ms ease,
			color 180ms ease;
	}

	.tier-optin-submit:hover {
		background: var(--ink);
		border-color: var(--ink);
		color: var(--bg);
	}

	.tier-optin-submit[disabled] {
		cursor: default;
		opacity: 0.5;
	}

	.tier-optin-status {
		margin: 0.1rem 0 0;
		color: var(--accent-ink);
		font-size: 0.6rem;
		line-height: 1.5;
	}

	.tier-cta:hover {
		background: var(--ink);
		border-color: var(--ink);
		color: var(--bg);
	}

	.tier-featured .tier-cta {
		border-color: var(--accent);
		background: rgba(207, 116, 64, 0.14);
		color: var(--accent-ink);
	}

	.tier-featured .tier-cta:hover {
		background: var(--accent);
		border-color: var(--accent);
		color: var(--bg);
	}

	.pricing-footnote {
		margin: 0;
		color: var(--soft);
		text-align: center;
	}

	@media (max-width: 900px) {
		.tiers {
			grid-template-columns: 1fr;
			max-width: 520px;
		}

		.pricing-main {
			align-content: start;
			padding-top: clamp(1.4rem, 4vh, 2.6rem);
		}
	}
</style>
