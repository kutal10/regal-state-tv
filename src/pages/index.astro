---
import Layout from '../layouts/Layout.astro';
import Gate from '../components/Gate.astro';
import { site, inquiries, artifacts, getArtifactBySlug, getChronologicalArtifacts } from '../data/site';

const latest = getChronologicalArtifacts()[0];
const ideaCount = 3;

const board = inquiries.map((inquiry) => ({
	...inquiry,
	artifacts: inquiry.artifactSlugs
		.map(getArtifactBySlug)
		.filter((a): a is NonNullable<typeof a> => Boolean(a)),
}));

const tensions = artifacts
	.filter((a) => a.contradicts)
	.map((a) => ({
		from: a,
		to: getArtifactBySlug(a.contradicts!.slug)!,
		label: a.contradicts!.label,
	}))
	.filter((t) => t.to && t.from.slug < t.to.slug);
---

<Layout title={`${site.name} — ${site.tagline}`}>
	<Gate email={site.email} />

	<div class="board">
		<header class="board-header">
			<a href="/" class="wordmark">Regal State <em>/ TV</em></a>
			<nav class="site-nav" aria-label="Primary">
				<a href="/" aria-current="page">Questions</a>
				<a href="/archive">Archive</a>
				<button class="nav-lock" type="button" id="lock-button">Lock</button>
			</nav>
		</header>

		<p class="board-standfirst">
			{board.length} questions open · {artifacts.length} artifacts · {ideaCount} seeds ·
			unresolved on purpose
		</p>

		<div class="board-body">
			{
				board.map((inquiry, i) => (
					<section class="column" aria-label={inquiry.question}>
						<p class="column-number kicker">{String(i + 1).padStart(2, '0')}</p>
						<h2 class="column-question">
							<a href={`#q-${inquiry.slug}`}>{inquiry.question}</a>
						</h2>

						<ul class="column-artifacts">
							{inquiry.artifacts.map((artifact) => (
								<li>
									<a class="artifact" href={`/watch/${artifact.slug}`}>
										<span class="artifact-title">{artifact.title}</span>
										<span class="artifact-meta">{artifact.duration}</span>
									</a>
								</li>
							))}
						</ul>

						<div class="column-open">
							<p class="open-kicker">Still open</p>
							<ul>
								{inquiry.openThreads.map((thread) => (
									<li>{thread}</li>
								))}
							</ul>
						</div>
					</section>
				))
			}

			<aside class="rail">
				{
					latest && (
						<div class="rail-block">
							<p class="open-kicker">Latest</p>
							<a class="rail-link" href={`/watch/${latest.slug}`}>
								<span class="rail-title">{latest.title}</span>
								<span class="rail-meta">
									{latest.duration} ·{' '}
									{new Date(`${latest.date}T00:00:00`).toLocaleDateString('en-GB', {
										month: 'long',
										year: 'numeric',
									})}
								</span>
							</a>
						</div>
					)
				}

				{
					tensions.length > 0 && (
						<div class="rail-block">
							<p class="open-kicker">In tension</p>
							{tensions.map((tension) => (
								<a class="rail-link" href={`/watch/${tension.from.slug}`}>
									<span class="rail-title">{tension.from.title}</span>
									<span class="rail-meta">against {tension.to.title}</span>
								</a>
							))}
						</div>
					)
				}

				<div class="rail-block">
					<p class="open-kicker">Full record</p>
					<a class="rail-link" href="/archive">
						<span class="rail-title">Archive</span>
						<span class="rail-meta">every piece, by state</span>
					</a>
				</div>
			</aside>
		</div>
	</div>

	<footer class="board-footer">
		<a href={`mailto:${site.email}`}>{site.email}</a>
		<span>
			<a href={site.instagram} target="_blank" rel="noreferrer">Instagram</a>
			{' / '}
			<a href={site.youtube} target="_blank" rel="noreferrer">YouTube</a>
		</span>
	</footer>
</Layout>

<script>
	document.getElementById('lock-button')?.addEventListener('click', () => {
		window.dispatchEvent(new CustomEvent('gate:request'));
	});
</script>

<style>
	.board {
		display: flex;
		flex-direction: column;
		min-height: 100svh;
		border-bottom: 1px solid var(--hairline);
	}

	.board-header {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		padding: 1.4rem clamp(18px, 3vw, 40px) 1.2rem;
		border-bottom: 1px solid var(--hairline);
	}

	.board-standfirst {
		margin: 0;
		padding: 0.7rem clamp(18px, 3vw, 40px);
		border-bottom: 1px solid var(--hairline);
		font-family: var(--mono);
		font-size: 0.68rem;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--soft);
	}

	.board-body {
		flex: 1;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr)) minmax(15rem, 0.72fr);
	}

	.column {
		display: flex;
		flex-direction: column;
		gap: 1.6rem;
		padding: clamp(1.6rem, 3vw, 2.6rem) clamp(1.2rem, 2.4vw, 2.2rem);
		border-right: 1px solid var(--hairline);
		min-width: 0;
	}

	.column-question {
		margin: 0;
		max-width: 16ch;
		font-size: clamp(1.5rem, 2.6vw, 2.35rem);
		font-weight: 300;
		line-height: 1.08;
		letter-spacing: -0.03em;
	}

	.column-question a {
		transition: color 160ms ease;
	}

	.column-question a:hover {
		color: var(--accent);
	}

	.column-artifacts {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.column-artifacts li + li {
		border-top: 1px solid var(--hairline);
	}

	.artifact {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.7rem 0;
		transition: color 160ms ease;
	}

	.artifact:hover {
		color: var(--accent);
	}

	.artifact-title {
		font-size: 1.06rem;
	}

	.artifact-meta {
		font-family: var(--mono);
		font-size: 0.64rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--soft);
		white-space: nowrap;
	}

	.column-open {
		margin-top: auto;
		padding-top: 1.2rem;
		border-top: 1px solid var(--hairline);
	}

	.open-kicker {
		margin: 0;
		font-family: var(--mono);
		font-size: 0.72rem;
		font-weight: 500;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--ink);
	}

	.column-open ul {
		margin: 0.6rem 0 0;
		padding: 0;
		list-style: none;
		color: var(--muted);
		font-size: 0.94rem;
		line-height: 1.4;
	}

	.column-open li + li {
		margin-top: 0.35rem;
	}

	.column-open li::before {
		content: '— ';
		color: var(--soft);
	}

	.rail {
		display: flex;
		flex-direction: column;
		gap: 1.8rem;
		padding: clamp(1.6rem, 3vw, 2.6rem) clamp(1.2rem, 2.4vw, 2.2rem);
		background: rgba(232, 228, 220, 0.02);
		min-width: 0;
	}

	.rail-block {
		display: grid;
		gap: 0.55rem;
	}

	.rail-block + .rail-block {
		padding-top: 1.5rem;
		border-top: 1px solid var(--hairline);
	}

	.rail-link {
		display: grid;
		gap: 0.25rem;
		transition: color 160ms ease;
	}

	.rail-link:hover .rail-title {
		color: var(--accent);
	}

	.rail-title {
		font-size: 1.12rem;
		letter-spacing: -0.01em;
	}

	.rail-meta {
		font-family: var(--mono);
		font-size: 0.64rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--soft);
	}

	.board-footer {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		flex-wrap: wrap;
		padding: 1.3rem clamp(18px, 3vw, 40px) 1.6rem;
		border-top: 1px solid var(--hairline);
		font-family: var(--mono);
		font-size: 0.68rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--soft);
	}

	.board-footer a {
		transition: color 160ms ease;
	}

	.board-footer a:hover {
		color: var(--ink);
	}

	.nav-lock {
		display: inline;
	}

	#lock-button {
		background: none;
		border: 0;
		padding: 0;
		font: inherit;
		color: inherit;
		letter-spacing: inherit;
		text-transform: inherit;
		cursor: pointer;
		transition: color 160ms ease;
	}

	#lock-button:hover {
		color: var(--ink);
	}

	@media (max-width: 1100px) {
		.board-body {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.rail {
			grid-column: 1 / -1;
			border-top: 1px solid var(--hairline);
			flex-direction: row;
			flex-wrap: wrap;
			gap: 2rem 4rem;
		}

		.rail-block + .rail-block {
			padding-top: 0;
			border-top: 0;
		}

		.column:nth-child(2n) {
			border-right: 0;
		}
	}

	@media (max-width: 680px) {
		.board-body {
			grid-template-columns: 1fr;
		}

		.column {
			border-right: 0;
			border-bottom: 1px solid var(--hairline);
		}

		.rail {
			flex-direction: column;
			gap: 1.8rem;
		}
	}
</style>