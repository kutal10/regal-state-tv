---
import Layout from '../layouts/Layout.astro';
import Gate from '../components/Gate.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import BubbleField from '../components/BubbleField.astro';
import { site } from '../data/site';
---

<Layout title={`${site.name} — ${site.tagline}`}>
	<Gate email={site.email} />

	<div class="page">
		<SiteHeader current="everything" />
		<main class="field-stage">
			<BubbleField />
		</main>
		<SiteFooter email={site.email} instagram={site.instagram} youtube={site.youtube} />
	</div>
</Layout>

<style>
	.field-stage {
		display: grid;
		grid-template-rows: minmax(0, 1fr);
		min-height: 0;
		padding: 0 clamp(16px, 3vw, 40px) clamp(0.6rem, 1.4vh, 1.1rem);
	}
</style>
