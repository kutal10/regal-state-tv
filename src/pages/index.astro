---
import Layout from '../layouts/Layout.astro';
import Gate from '../components/Gate.astro';
import YouTubeEmbed from '../components/YouTubeEmbed.astro';
import {
	site,
	inquiries,
	artifacts,
	getArtifactBySlug,
	getChronologicalArtifacts,
} from '../data/site';

const latest = getChronologicalArtifacts()[0];
const artifactCount = artifacts.length;
const questionCount = inquiries.length;

const inquiriesWithArtifacts = inquiries.map((inquiry) => ({
	...inquiry,
	artifacts: inquiry.artifactSlugs
		.map(getArtifactBySlug)
		.filter((a): a is NonNullable<typeof a> => Boolean(a)),
}));
---

<Layout title={`${site.name} — ${site.tagline}`}>
	<Gate email={site.email} />

	<header class="site-header shell">
		<a href="/" class="wordmark">Regal State <em>/ TV</em></a>
		<nav class="site-nav" aria-label="Primary">
			<a href="/" aria-current="page">Questions</a>
			<a href="/archive">Archive</a>
			<button class="nav-lock" type="button" id="lock-button">Lock</button>
		</nav>
	</header>

	<main>
		<section class="shell opening">
			<p class="kicker">An index of open questions</p>
			<h1>
				This is not a feed. It is a set of questions we are investigating in
				public, one artifact at a time.
			</h1>
			<p class="opening-line">
				Every video below is a piece of an ongoing inquiry — with the references
				that shaped it, the arguments it enters, and the questions it leaves
				open. Where it goes next is unwritten.
			</p>
		</section>

		{
			latest && (
				<section class="shell latest" aria-labelledby="latest-heading">
					<hr class="rule" />
					<div class="latest-grid">
						<div class="latest-copy">
							<p class="kicker">Latest artifact</p>
							<h2 id="latest-heading">
								<a href={`/watch/${latest.slug}`}>{latest.title}</a>
							</h2>
							<p class="latest-summary">{latest.summary}</p>
							<p class="latest-meta">
								{latest.date} · {latest.duration}
							</p>
						</div>
						<div class="latest-embed">
							<YouTubeEmbed id={latest.youtubeId!} title={latest.title} />
						</div>
					</div>
				</section>
			)
		}

		<section class="shell index" aria-label="Open questions">
			{
				inquiriesWithArtifacts.map((inquiry, i) => (
					<article class="inquiry">
						<hr class="rule" />
						<header class="inquiry-head">
							<span class="inquiry-number">
								{String(i + 1).padStart(2, '0')}
							</span>
							<div>
								<h3 class="inquiry-question">{inquiry.question}</h3>
								<p class="inquiry-line">{inquiry.line}</p>
							</div>
						</header>

						<ul class="artifact-list">
							{inquiry.artifacts.map((artifact) => (
								<li>
									<a class="artifact-row" href={`/watch/${artifact.slug}`}>
										<span class="artifact-title">{artifact.title}</span>
										<span class="artifact-meta">
											{artifact.kind} · {artifact.duration}
										</span>
									</a>
								</li>
							))}
						</ul>

						<div class="inquiry-threads">
							<p class="kicker">Still open here</p>
							<ul>
								{inquiry.openThreads.map((thread) => (
									<li>{thread}</li>
								))}
							</ul>
						</div>
					</article>
				))
			}
		</section>

		<section class="shell colophon">
			<hr class="rule" />
			<p>
				{questionCount} questions open · {artifactCount} artifacts so far. The
				full record — every artifact, dated — lives in the{' '}
				<a href="/archive">archive</a>.
			</p>
		</section>
	</main>

	<footer class="site-footer shell">
		<a href={`mailto:${site.email}`}>{site.email}</a>
		<span>
			<a href={site.instagram} target="_blank" rel="noreferrer">Instagram</a>
			{' / '}
			<a href={site.youtube} target="_blank" rel="noreferrer">YouTube</a>
		</span>
	</footer>
</Layout>

<script>
	document.getElementById('lock-button')?.addEventListener('click', () => {
		window.dispatchEvent(new CustomEvent('gate:request'));
	});
</script>

<style>
	.opening {
		padding: clamp(3.5rem, 9vw, 7rem) 0 clamp(2.5rem, 6vw, 4.5rem);
	}

	.opening h1 {
		margin: 1.4rem 0 0;
		max-width: 24ch;
		font-size: clamp(2rem, 4.6vw, 3.6rem);
		font-weight: 300;
		line-height: 1.08;
		letter-spacing: -0.03em;
	}

	.opening-line {
		margin: 1.6rem 0 0;
		max-width: 58ch;
		font-size: clamp(1.02rem, 1.6vw, 1.18rem);
		color: var(--muted);
	}

	.latest {
		padding: clamp(2rem, 4vw, 3rem) 0;
	}

	.latest-grid {
		display: grid;
		grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
		gap: clamp(1.6rem, 3.5vw, 3.5rem);
		align-items: start;
		padding-top: clamp(1.8rem, 4vw, 3rem);
	}

	.latest-copy h2 {
		margin: 1.2rem 0 0;
		font-size: clamp(1.7rem, 3.2vw, 2.6rem);
		font-weight: 300;
		line-height: 1.05;
		letter-spacing: -0.03em;
	}

	.latest-copy a:hover {
		color: var(--accent);
	}

	.latest-summary {
		margin: 1.1rem 0 0;
		color: var(--muted);
	}

	.latest-meta {
		margin: 1rem 0 0;
		font-family: var(--mono);
		font-size: 0.72rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--soft);
	}

	.inquiry {
		padding-bottom: clamp(2rem, 4vw, 3.2rem);
	}

	.inquiry-head {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: clamp(1.2rem, 3vw, 2.4rem);
		align-items: start;
		padding-top: clamp(1.8rem, 4vw, 3rem);
	}

	.inquiry-number {
		font-family: var(--mono);
		font-size: 0.78rem;
		color: var(--soft);
		padding-top: 0.5em;
	}

	.inquiry-question {
		margin: 0;
		max-width: 22ch;
		font-size: clamp(1.55rem, 3.4vw, 2.7rem);
		font-weight: 300;
		line-height: 1.06;
		letter-spacing: -0.035em;
	}

	.inquiry-line {
		margin: 0.8rem 0 0;
		max-width: 62ch;
		color: var(--muted);
	}

	.artifact-list {
		margin: 1.6rem 0 0;
		padding: 0;
		list-style: none;
	}

	.artifact-list li + li {
		border-top: 1px solid var(--hairline);
	}

	.artifact-row {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1.5rem;
		padding: 0.85rem 0;
		transition: color 160ms ease;
	}

	.artifact-row:hover {
		color: var(--accent);
	}

	.artifact-title {
		font-size: 1.12rem;
	}

	.artifact-meta {
		font-family: var(--mono);
		font-size: 0.7rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--soft);
		white-space: nowrap;
	}

	.inquiry-threads {
		margin-top: 1.4rem;
	}

	.inquiry-threads ul {
		margin: 0.7rem 0 0;
		padding: 0;
		list-style: none;
		color: var(--muted);
	}

	.inquiry-threads li::before {
		content: '— ';
		color: var(--soft);
	}

	.colophon {
		padding: 2rem 0 0;
	}

	.colophon p {
		margin: 1.6rem 0 0;
		color: var(--soft);
	}

	.colophon a {
		color: var(--muted);
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.colophon a:hover {
		color: var(--ink);
	}

	.nav-lock {
		display: none;
	}

	.nav-lock {
		display: inline;
	}

	#lock-button {
		background: none;
		border: 0;
		padding: 0;
		font: inherit;
		color: var(--muted);
		letter-spacing: inherit;
		text-transform: inherit;
		cursor: pointer;
		transition: color 160ms ease;
	}

	#lock-button:hover {
		color: var(--ink);
	}

	@media (max-width: 880px) {
		.latest-grid {
			grid-template-columns: 1fr;
		}

		.latest-embed {
			order: -1;
		}
	}

	@media (max-width: 720px) {
		.artifact-row {
			flex-direction: column;
			gap: 0.3rem;
			align-items: flex-start;
		}
	}
</style>