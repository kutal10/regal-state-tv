---
interface Props {
	title: string;
	description?: string;
}

const { title, description = 'A curated body of questions, investigations, and documentaries by Regal State.' } =
	Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<link rel="icon" type="image/svg+xml" href="/LOGO_1.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#0c0c0c" />
		<title>{title}</title>
		<script is:inline>
			(() => {
				try {
					if (localStorage.getItem('rs_unlocked') !== 'yes') {
						document.documentElement.setAttribute('data-locked', '');
					}
				} catch {
					document.documentElement.setAttribute('data-locked', '');
				}
			})();
		</script>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	@import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Newsreader:ital,opsz,wght@0,6..72,300;0,6..72,400;0,6..72,500;1,6..72,400&display=swap');

	:root {
		--bg: #0c0c0c;
		--ink: #e8e4dc;
		--muted: rgba(232, 228, 220, 0.58);
		--soft: rgba(232, 228, 220, 0.36);
		--hairline: rgba(232, 228, 220, 0.14);
		--hairline-strong: rgba(232, 228, 220, 0.28);
		--accent: #c6b598;
		--container: min(1160px, 100% - 48px);
		--mono: 'IBM Plex Mono', ui-monospace, monospace;
		--serif: 'Newsreader', Georgia, serif;
		--sans: 'Newsreader', Georgia, serif;
	}

	* {
		box-sizing: border-box;
	}

	html {
		background: var(--bg);
		color-scheme: dark;
		scroll-behavior: smooth;
	}

	body {
		margin: 0;
		min-height: 100svh;
		background: var(--bg);
		color: var(--ink);
		font-family: var(--serif);
		font-weight: 300;
		line-height: 1.55;
		-webkit-font-smoothing: antialiased;
		text-rendering: optimizeLegibility;
	}

	::selection {
		background: rgba(198, 181, 152, 0.24);
	}

	a {
		color: inherit;
		text-decoration: none;
	}

	img {
		display: block;
		max-width: 100%;
	}

	[data-locked] body > :not(.gate) {
		display: none !important;
	}

	html[data-locked] body {
		overflow: hidden;
	}

	.shell {
		width: var(--container);
		margin: 0 auto;
	}

	.site-header {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		padding: 1.6rem 0;
		border-bottom: 1px solid var(--hairline);
	}

	.wordmark {
		font-family: var(--mono);
		font-size: 0.82rem;
		font-weight: 500;
		letter-spacing: 0.22em;
		text-transform: uppercase;
	}

	.wordmark em {
		font-style: normal;
		color: var(--soft);
	}

	.site-nav {
		display: flex;
		gap: 1.75rem;
		font-family: var(--mono);
		font-size: 0.72rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.site-nav a {
		transition: color 160ms ease;
	}

	.site-nav a:hover,
	.site-nav a[aria-current='page'] {
		color: var(--ink);
	}

	.site-footer {
		margin-top: 8rem;
		padding: 2rem 0 3rem;
		border-top: 1px solid var(--hairline);
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		flex-wrap: wrap;
		font-family: var(--mono);
		font-size: 0.72rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--soft);
	}

	.site-footer a {
		transition: color 160ms ease;
	}

	.site-footer a:hover {
		color: var(--ink);
	}

	.kicker {
		margin: 0;
		font-family: var(--mono);
		font-size: 0.7rem;
		font-weight: 400;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: var(--soft);
	}

	.rule {
		border: 0;
		border-top: 1px solid var(--hairline);
		margin: 0;
	}

	@media (max-width: 720px) {
		:root {
			--container: min(100% - 36px, 1160px);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		html {
			scroll-behavior: auto;
		}
	}
</style>