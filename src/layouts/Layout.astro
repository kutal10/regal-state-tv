---
interface Props {
	title: string;
	description?: string;
	ungated?: boolean;
}

const {
	title,
	description = 'A curated body of questions, investigations, and documentaries by Regal State.',
	ungated = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<link rel="icon" type="image/svg+xml" href="/LOGO_1.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#0e0b09" />
		<title>{title}</title>
		<script is:inline define:vars={{ ungated }}>
			(() => {
				if (!ungated) {
					try {
						if (localStorage.getItem('rs_unlocked') !== 'yes') {
							document.documentElement.setAttribute('data-locked', '');
						}
					} catch {
						document.documentElement.setAttribute('data-locked', '');
					}
				}

				try {
					const raw = localStorage.getItem('rs_progress');
					const progress = raw ? JSON.parse(raw) : null;
					const list = (key) =>
						progress && Array.isArray(progress[key])
							? progress[key].filter((slug) => typeof slug === 'string')
							: [];
					const unique = (...lists) => [...new Set(lists.flat())];
					const root = document.documentElement;
					root.dataset.seen = list('seen').join(' ');
					root.dataset.played = unique(list('played'), list('seen')).join(' ');
					root.dataset.visited = unique(list('visited'), list('played'), list('seen')).join(' ');
				} catch {
					/* storage unavailable */
				}
			})();
		</script>
	</head>
	<body>
		<div class="backdrop" aria-hidden="true"></div>
		<slot />
	</body>
</html>

<style is:global>
	@import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&family=Newsreader:ital,opsz,wght@0,6..72,300;0,6..72,400;0,6..72,500;1,6..72,400&display=swap');

	:root {
		--bg: #0e0b09;
		--ink: #ebe4d8;
		--muted: rgba(235, 228, 216, 0.68);
		--soft: rgba(235, 228, 216, 0.44);
		--hairline: rgba(235, 228, 216, 0.16);
		--hairline-strong: rgba(235, 228, 216, 0.36);
		--accent: #cf7440;
		--accent-ink: #e08e5c;
		--green: #7dba85;
		--mono: 'IBM Plex Mono', ui-monospace, monospace;
		--serif: 'Newsreader', Georgia, serif;
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	html {
		background: var(--bg);
		color-scheme: dark;
	}

	body {
		margin: 0;
		min-height: 100svh;
		background: var(--bg);
		color: var(--ink);
		font-family: var(--serif);
		font-weight: 400;
		line-height: 1.5;
		-webkit-font-smoothing: antialiased;
		text-rendering: optimizeLegibility;
	}

	.backdrop {
		position: fixed;
		inset: 0;
		z-index: -2;
		pointer-events: none;
		background:
			linear-gradient(rgba(10, 8, 7, 0.82), rgba(10, 8, 7, 0.82)),
			url('/bg3.webp') center center / cover no-repeat;
		transform: translateZ(0);
	}

	.backdrop::after {
		content: '';
		position: absolute;
		inset: -10%;
		background: url('/grain.webp') center center / 320px repeat;
		opacity: 0.32;
		mix-blend-mode: overlay;
	}

	::selection {
		background: rgba(207, 116, 64, 0.28);
	}

	a {
		color: inherit;
		text-decoration: none;
	}

	img {
		display: block;
		max-width: 100%;
	}

	[data-locked] body > :not(.gate) {
		display: none !important;
	}

	html[data-locked] body {
		overflow: hidden;
	}

	.page {
		display: grid;
		grid-template-rows: auto minmax(0, 1fr) auto;
		height: 100svh;
		overflow: hidden;
	}

	.mono {
		font-family: var(--mono);
		font-size: 0.68rem;
		font-weight: 400;
		letter-spacing: 0.13em;
		text-transform: uppercase;
	}

	@media (max-width: 720px) {
		.page {
			grid-template-rows: auto minmax(0, 1fr) auto;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		* {
			scroll-behavior: auto !important;
			transition-duration: 0.01ms !important;
			animation-duration: 0.01ms !important;
		}
	}
</style>
