---
import { getUniverseZones, isPlayableVideo } from '../lib/universe';

const initialZones = getUniverseZones({ saved: [] });
const countPlayableVideos = (items: (typeof initialZones)[number]['items']) =>
	items.filter(isPlayableVideo).length;
const videoCountLabel = (count: number) =>
	count === 0 ? 'No videos yet' : `${count} ${count === 1 ? 'video' : 'videos'}`;
const initialItemCount = countPlayableVideos(initialZones.find((zone) => zone.id === 'culture')?.items ?? []);
---

<section class="universe-section" aria-labelledby="universe-heading">
	<h2 id="universe-heading" class="visually-hidden">Explore the video universe</h2>

	<div class="map-toolbar">
		<nav class="breadcrumbs mono" aria-label="Map location">
			<button type="button" data-back hidden aria-label="Go back one level">←</button>
			<ol data-breadcrumbs>
				<li><span aria-current="page">Universe</span></li>
			</ol>
		</nav>

		<label class="map-search">
			<span class="visually-hidden">Search the universe</span>
			<input type="search" placeholder="Search the universe" autocomplete="off" data-map-search />
		</label>
	</div>

	<div class="map-viewport" data-map-viewport>
		<div class="map-scene" data-map-scene>
			<div class="map-nodes" data-map-nodes>
				{
					initialZones.map((zone) => {
						const videoCount = countPlayableVideos(zone.items);
						return (
							<div
								class:list={['map-node-wrap', 'zone-wrap', `size-${zone.size}`]}
								data-node-id={zone.id}
								data-node-type="zone"
								data-zone={zone.id}
								data-empty={videoCount === 0 ? 'true' : undefined}
								style={`--x:${zone.position.x}%;--y:${zone.position.y}%`}
							>
								<button
									class="map-node zone-node"
									type="button"
									disabled={videoCount === 0}
									aria-label={`${zone.title}, ${videoCountLabel(videoCount)}`}
								>
									<span class="node-mosaic" data-count={Math.min(zone.items.length, 5)} aria-hidden="true">
										{zone.items.slice(0, 5).map((item) => (
											<span style={`--texture:url('/textures-lowres/${item.texture}.webp')`} />
										))}
									</span>
									<span class="node-copy">
										<span class="node-title">{zone.title}</span>
										<span class="node-count mono">{videoCountLabel(videoCount)}</span>
									</span>
								</button>
							</div>
						);
					})
				}
			</div>
		</div>
		<p class="map-empty" data-map-empty role="status" hidden></p>
		<aside class="seed-detail" data-seed-detail hidden aria-live="polite"></aside>
	</div>

	<div class="map-readout">
		<p class="readout-line mono" aria-live="polite" data-map-readout>
			{initialItemCount} works · 0 saved · 0 seen
		</p>
		<button class="reset mono" type="button" id="field-reset">reset</button>
	</div>
</section>

<script>
	import { clearProgress, loadProgress, snapshot, toggle, PROGRESS_EVENT } from '../lib/progress';
	import { getItemById, getUniverseZones, isPlayableVideo, universeItems } from '../lib/universe';
	import { tierFor } from '../lib/bubbles';

	type MapNode = {
		id: string;
		title: string;
		type: 'zone' | 'constellation' | 'item';
		searchText: string;
		items: typeof universeItems;
		position?: { x: number; y: number };
		size?: 'large' | 'medium' | 'small';
		item?: (typeof universeItems)[number];
	};

	function countPlayableVideos(items: typeof universeItems) {
		return items.filter(isPlayableVideo).length;
	}

	function videoCountLabel(count: number) {
		return count === 0 ? 'No videos yet' : `${count} ${count === 1 ? 'video' : 'videos'}`;
	}

	const nodesRoot = document.querySelector<HTMLElement>('[data-map-nodes]');
	const scene = document.querySelector<HTMLElement>('[data-map-scene]');
	const viewport = document.querySelector<HTMLElement>('[data-map-viewport]');
	const searchInput = document.querySelector<HTMLInputElement>('[data-map-search]');
	const breadcrumbs = document.querySelector<HTMLOListElement>('[data-breadcrumbs]');
	const backButton = document.querySelector<HTMLButtonElement>('[data-back]');
	const emptyMessage = document.querySelector<HTMLElement>('[data-map-empty]');
	const seedDetail = document.querySelector<HTMLElement>('[data-seed-detail]');
	const readout = document.querySelector<HTMLElement>('[data-map-readout]');
	const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

	let path: string[] = [];
	let mapPathHistory: string[][] = [];
	let search = '';
	let selectedSeed: string | null = null;
	let navigationToken = 0;

	function zones() {
		return getUniverseZones(loadProgress());
	}

	function pathFromHash(): string[] {
		const raw = window.location.hash.slice(1);
		if (!raw) return [];
		try {
			return raw.split('/').map((part) => decodeURIComponent(part));
		} catch {
			return [];
		}
	}

	function validPath(candidate: string[]): string[] {
		const currentZones = zones();
		const zone = currentZones.find((entry) => entry.id === candidate[0]);
		if (!zone) return [];
		if (candidate.length < 2) return [zone.id];
		const constellation = zone.constellations.find((entry) => entry.id === candidate[1]);
		return constellation ? [zone.id, constellation.id] : [zone.id];
	}

	const statePath = window.history.state?.mapPath;
	path = validPath(Array.isArray(statePath) ? statePath : pathFromHash());
	const stateStack = window.history.state?.mapStack;
	mapPathHistory = Array.isArray(stateStack) ? stateStack.map((entry: string[]) => validPath(entry)) : [path];
	if (!mapPathHistory.length || mapPathHistory.at(-1)?.join('/') !== path.join('/')) mapPathHistory = [path];
	window.history.replaceState(
		{ ...(window.history.state ?? {}), mapPath: path, mapStack: mapPathHistory },
		'',
		`${window.location.pathname}${window.location.search}${path.length ? `#${path.map(encodeURIComponent).join('/')}` : ''}`,
	);

	function urlFor(nextPath: string[]) {
		const hash = nextPath.length ? `#${nextPath.map(encodeURIComponent).join('/')}` : '';
		return `${window.location.pathname}${window.location.search}${hash}`;
	}

	function replacePath(nextPath: string[]) {
		path = validPath(nextPath);
		mapPathHistory = [path];
		selectedSeed = null;
		window.history.replaceState(
			{ ...(window.history.state ?? {}), mapPath: path, mapStack: mapPathHistory },
			'',
			urlFor(path),
		);
		render(true);
	}

	function navigateToDepth(depth: number) {
		const stepsBack = mapPathHistory.length - 1 - depth;
		if (stepsBack > 0) {
			window.history.go(-stepsBack);
			return;
		}
		replacePath(path.slice(0, depth));
	}

	function pushPath(nextPath: string[]) {
		path = validPath(nextPath);
		mapPathHistory = [...mapPathHistory, path];
		selectedSeed = null;
		window.history.pushState(
			{ ...(window.history.state ?? {}), mapPath: path, mapStack: mapPathHistory },
			'',
			urlFor(path),
		);
		render(true);
	}

	function nodesAtCurrentDepth(): MapNode[] {
		const currentZones = zones();
		if (path.length === 0) {
			return currentZones.map((zone) => ({
				id: zone.id,
				title: zone.title,
				type: 'zone',
				searchText: zone.searchText,
				items: zone.items,
				position: zone.position,
				size: zone.size,
			}));
		}

		const zone = currentZones.find((entry) => entry.id === path[0]);
		if (!zone) return [];
		if (path.length === 1) {
			return zone.constellations.map((constellation) => ({
				id: constellation.id,
				title: constellation.title,
				type: 'constellation',
				searchText: constellation.searchText,
				items: constellation.items,
				size: constellation.items.length > 2 ? 'medium' : 'small',
			}));
		}

		const constellation = zone.constellations.find((entry) => entry.id === path[1]);
		if (!constellation) return [];
		return constellation.items.map((item) => ({
			id: item.id,
			title: item.title,
			type: 'item',
			searchText: item.searchText,
			items: [item],
			item,
			size: item.seed ? 'small' : 'medium',
		}));
	}

	function matchesNode(node: MapNode, query = search.trim().toLowerCase()) {
		if (!query || node.searchText.toLowerCase().includes(query)) return true;
		const zone = path.length ? zones().find((entry) => entry.id === path[0]) : undefined;
		if (zone?.title.toLowerCase().includes(query)) return true;
		if (path.length > 1) {
			const constellation = zone?.constellations.find((entry) => entry.id === path[1]);
			if (constellation?.title.toLowerCase().includes(query)) return true;
		}
		return false;
	}

	function positionFor(node: MapNode, index: number, total: number) {
		if (node.position) {
			if (window.matchMedia('(max-width: 720px)').matches) {
				const mobilePositions: Record<string, { x: number; y: number }> = {
					technology: { x: 26, y: 15 },
					film: { x: 74, y: 15 },
					politics: { x: 26, y: 39 },
					culture: { x: 74, y: 39 },
					sport: { x: 26, y: 63 },
					saved: { x: 74, y: 63 },
					recent: { x: 50, y: 86 },
				};
				return mobilePositions[node.id] ?? node.position;
			}
			return node.position;
		}
		if (total <= 1) return { x: 50, y: 50 };
		const angle = -Math.PI / 2 + (Math.PI * 2 * index) / total;
		const mobile = window.matchMedia('(max-width: 720px)').matches;
		return {
			x: 50 + Math.cos(angle) * (mobile ? 28 : 31),
			y: 50 + Math.sin(angle) * (mobile ? 25 : 29),
		};
	}

	function makeMosaic(items: typeof universeItems) {
		const mosaic = document.createElement('span');
		mosaic.className = 'node-mosaic';
		mosaic.dataset.count = String(Math.min(items.length, 5));
		mosaic.setAttribute('aria-hidden', 'true');
		for (const item of items.slice(0, 5)) {
			const tile = document.createElement('span');
			tile.style.setProperty('--texture', `url('/textures-lowres/${item.texture}.webp')`);
			mosaic.append(tile);
		}
		return mosaic;
	}

	function makeSaveButton(item: (typeof universeItems)[number], saved: boolean) {
		const button = document.createElement('button');
		button.type = 'button';
		button.className = 'node-save mono';
		button.dataset.save = item.id;
		button.setAttribute('aria-pressed', String(saved));
		button.setAttribute('aria-label', `${saved ? 'Remove' : 'Save'} ${item.title}${saved ? ' from saved items' : ' to saved items'}`);
		button.title = saved ? 'Remove from Saved' : 'Save this piece';
		button.innerHTML = '<svg viewBox="0 0 16 18" aria-hidden="true"><path d="M3 2.5h10v13l-5-3.3-5 3.3z" /></svg>';
		button.addEventListener('click', (event) => {
			event.preventDefault();
			event.stopPropagation();
			const returnFocus = document.activeElement === button;
			toggle('saved', item.id);
			render(false);
			if (returnFocus) {
				nodesRoot?.querySelector<HTMLButtonElement>(`[data-save="${item.id}"]`)?.focus({ preventScroll: true });
			}
		});
		return button;
	}

	function makeNodeElement(node: MapNode, index: number, total: number, matched: boolean): HTMLElement {
		const videoCount = countPlayableVideos(node.items);
		const canOpen = node.type === 'item' || videoCount > 0;
		const position = positionFor(node, index, total);
		if (search && matched) {
			position.x += (50 - position.x) * 0.16;
			position.y += (50 - position.y) * 0.16;
		}
		const wrapper = document.createElement('div');
		wrapper.className = `map-node-wrap ${node.type}-wrap size-${node.size ?? 'small'}`;
		wrapper.dataset.nodeId = node.id;
		wrapper.dataset.nodeType = node.type;
		wrapper.dataset.searchMatch = String(matched);
		wrapper.dataset.empty = String(!canOpen);
		if (node.type === 'zone') wrapper.dataset.zone = node.id;
		wrapper.style.setProperty('--x', `${position.x}%`);
		wrapper.style.setProperty('--y', `${position.y}%`);

		const progress = loadProgress();
		const currentProgress = snapshot(progress);
		const item = node.item;
		const saved = item ? progress.saved.includes(item.id) : false;
		const nodeElement: HTMLElement = item?.href
			? document.createElement('a')
			: document.createElement('button');
		nodeElement.className = `map-node ${node.type}-node${item?.seed ? ' seed-node' : ''}`;
		if (nodeElement instanceof HTMLAnchorElement && item?.href) {
			nodeElement.href = item.href;
			nodeElement.setAttribute('aria-label', `${item.title}, ${item.duration}. Open this piece.`);
		} else if (nodeElement instanceof HTMLButtonElement) {
			nodeElement.type = 'button';
			nodeElement.disabled = !canOpen;
			nodeElement.setAttribute(
				'aria-label',
				item?.seed
					? `${item.title}, idea seed. Show details.`
					: canOpen
						? `${node.title}, ${videoCountLabel(videoCount)}. Enter.`
						: `${node.title}, ${videoCountLabel(videoCount)}. Unavailable.`,
			);
		}
		if (item) {
			nodeElement.dataset.tier = tierFor(currentProgress, item.id);
			nodeElement.dataset.saved = String(saved);
			nodeElement.style.setProperty('--texture', `url('/textures-lowres/${item.texture}.webp')`);
		} else {
			nodeElement.dataset.count = String(videoCount);
		}

		nodeElement.append(makeMosaic(item ? [item] : node.items));
		const copy = document.createElement('span');
		copy.className = 'node-copy';
		const title = document.createElement('span');
		title.className = 'node-title';
		title.textContent = node.title;
		copy.append(title);
		const count = document.createElement('span');
		count.className = 'node-count mono';
		count.textContent = item ? (item.seed ? 'seed' : item.duration) : videoCountLabel(videoCount);
		copy.append(count);
		if (item?.seed) {
			const seedMark = document.createElement('span');
			seedMark.className = 'seed-mark mono';
			seedMark.textContent = 'not made yet';
			copy.append(seedMark);
		}
		nodeElement.append(copy);
		wrapper.append(nodeElement);

		if (item) wrapper.append(makeSaveButton(item, saved));

		if (item?.seed) {
			nodeElement.addEventListener('click', () => {
				selectedSeed = item.id;
				render(false);
				seedDetail?.querySelector<HTMLButtonElement>('button')?.focus({ preventScroll: true });
			});
		}
		if (node.type !== 'item' && canOpen) {
			nodeElement.addEventListener('click', () => {
				const nextPath = node.type === 'zone' ? [node.id] : [...path, node.id];
				flyInto(wrapper, nextPath);
			});
		}

		if (canOpen) {
			wrapper.addEventListener('pointerenter', () => shiftNeighbors(wrapper));
			wrapper.addEventListener('pointerleave', clearNeighborShifts);
			wrapper.addEventListener('focusin', () => shiftNeighbors(wrapper));
			wrapper.addEventListener('focusout', (event) => {
				if (!wrapper.contains(event.relatedTarget as Node | null)) clearNeighborShifts();
			});
		}
		return wrapper;
	}

	function currentEmptyMessage() {
		const nodes = nodesAtCurrentDepth();
		if (search && nodes.length > 0 && !nodes.some((node) => matchesNode(node))) {
			return `No matches for “${searchInput?.value.trim() ?? search}”.`;
		}
		if (nodes.length > 0 || path.length === 0) return '';
		const zone = zones().find((entry) => entry.id === path[0]);
		if (!zone) return '';
		if (path.length === 1) return zone.emptyMessage;
		return 'No pieces in this constellation yet.';
	}

	function updateBreadcrumbs() {
		if (!breadcrumbs) return;
		breadcrumbs.replaceChildren();
		const rootCrumb = document.createElement('li');
		if (!path.length) {
			const current = document.createElement('span');
			current.textContent = 'Universe';
			current.setAttribute('aria-current', 'page');
			rootCrumb.append(current);
		} else {
			const button = document.createElement('button');
			button.type = 'button';
			button.textContent = 'Universe';
			button.addEventListener('click', () => navigateToDepth(0));
			rootCrumb.append(button);
		}
		breadcrumbs.append(rootCrumb);

		if (path.length) {
			const zone = zones().find((entry) => entry.id === path[0]);
			if (zone) appendCrumb(zone.title, 1, path.length === 1);
			if (path.length > 1 && zone) {
				const constellation = zone.constellations.find((entry) => entry.id === path[1]);
				if (constellation) appendCrumb(constellation.title, 2, true);
			}
		}
		if (backButton) backButton.hidden = path.length === 0;
	}

	function appendCrumb(title: string, depth: number, current: boolean) {
		if (!breadcrumbs) return;
		const li = document.createElement('li');
		if (current) {
			const span = document.createElement('span');
			span.textContent = title;
			span.setAttribute('aria-current', 'page');
			li.append(span);
		} else {
			const button = document.createElement('button');
			button.type = 'button';
			button.textContent = title;
			button.addEventListener('click', () => navigateToDepth(depth));
			li.append(button);
		}
		breadcrumbs.append(li);
	}

	function updateReadout() {
		if (!readout) return;
		const progress = loadProgress();
		const archiveItems = universeItems.filter((item) => !item.seed);
		const seenCount = archiveItems.filter((item) => progress.seen.includes(item.id)).length;
		const savedCount = new Set(progress.saved.filter((id) => universeItems.some((item) => item.id === id))).size;
		const nextText = `${archiveItems.length} works · ${savedCount} saved · ${seenCount} seen`;
		if (readout.textContent !== nextText) readout.textContent = nextText;
	}

	function showSeedDetail() {
		if (!seedDetail || !selectedSeed) return;
		const item = getItemById(selectedSeed);
		if (!item) return;
		seedDetail.replaceChildren();
		const top = document.createElement('div');
		top.className = 'seed-detail-top';
		const label = document.createElement('p');
		label.className = 'mono';
		label.textContent = 'Idea seed';
		const close = document.createElement('button');
		close.type = 'button';
		close.className = 'seed-detail-close mono';
		close.textContent = 'Close';
		close.addEventListener('click', () => {
			selectedSeed = null;
			seedDetail.hidden = true;
		});
		top.append(label, close);
		const title = document.createElement('h3');
		title.textContent = item.title;
		const summary = document.createElement('p');
		summary.textContent = item.summary;
		const state = document.createElement('p');
		state.className = 'mono';
		state.textContent = 'Not made yet';
		seedDetail.append(top, title, summary, state);
		seedDetail.hidden = false;
	}

	function render(focusFirst = false) {
		if (!nodesRoot) return;
		const nodes = nodesAtCurrentDepth();
		const matches = nodes.map((node) => matchesNode(node));
		nodesRoot.replaceChildren(...nodes.map((node, index) => makeNodeElement(node, index, nodes.length, matches[index])));
		const noMatches = Boolean(search) && nodes.length > 0 && !matches.some(Boolean);
		const emptyText = currentEmptyMessage();
		if (emptyMessage) {
			emptyMessage.textContent = emptyText;
			emptyMessage.hidden = !emptyText;
			emptyMessage.dataset.noMatches = String(noMatches);
		}
		if (seedDetail) {
			if (selectedSeed) showSeedDetail();
			else seedDetail.hidden = true;
		}
		updateBreadcrumbs();
		updateReadout();
		if (focusFirst) nodesRoot.querySelector<HTMLElement>('.map-node')?.focus({ preventScroll: true });
	}

	function shiftNeighbors(active: HTMLElement) {
		if (!nodesRoot || reducedMotion.matches) return;
		const activeRect = active.getBoundingClientRect();
		const centerX = activeRect.left + activeRect.width / 2;
		const centerY = activeRect.top + activeRect.height / 2;
		for (const sibling of nodesRoot.querySelectorAll<HTMLElement>('.map-node-wrap')) {
			if (sibling === active) continue;
			const rect = sibling.getBoundingClientRect();
			const dx = rect.left + rect.width / 2 - centerX;
			const dy = rect.top + rect.height / 2 - centerY;
			const distance = Math.max(Math.hypot(dx, dy), 1);
			if (distance > Math.max(viewport?.clientWidth ?? 0, viewport?.clientHeight ?? 0) * 0.68) continue;
			const amount = Math.max(5, 40 - distance * 0.035);
			sibling.dataset.nearby = 'true';
			sibling.style.setProperty('--shift-x', `${(dx / distance) * amount}px`);
			sibling.style.setProperty('--shift-y', `${(dy / distance) * amount}px`);
		}
	}

	function clearNeighborShifts() {
		for (const sibling of nodesRoot?.querySelectorAll<HTMLElement>('[data-nearby]') ?? []) {
			sibling.removeAttribute('data-nearby');
			sibling.style.removeProperty('--shift-x');
			sibling.style.removeProperty('--shift-y');
		}
	}

	function flyInto(origin: HTMLElement, nextPath: string[]) {
		if (!scene || reducedMotion.matches) {
			pushPath(nextPath);
			return;
		}
		const sceneRect = scene.getBoundingClientRect();
		const originRect = origin.getBoundingClientRect();
		const originX = originRect.left + originRect.width / 2 - sceneRect.left;
		const originY = originRect.top + originRect.height / 2 - sceneRect.top;
		scene.style.transformOrigin = `${originX}px ${originY}px`;
		scene.classList.add('flying-in');
		const token = ++navigationToken;
		window.setTimeout(() => {
			if (token !== navigationToken) return;
			pushPath(nextPath);
			scene.classList.remove('flying-in');
			scene.classList.add('arriving');
			window.requestAnimationFrame(() => {
				scene.classList.remove('arriving');
				scene.style.removeProperty('transform-origin');
			});
		}, 360);
	}

	function backOneLevel() {
		if (!path.length) return;
		if (seedDetail && !seedDetail.hidden) {
			selectedSeed = null;
			seedDetail.hidden = true;
			return;
		}
		if (mapPathHistory.length > 1) window.history.back();
		else replacePath(path.slice(0, -1));
	}

	searchInput?.addEventListener('input', () => {
		search = searchInput.value.trim();
		render(false);
	});

	backButton?.addEventListener('click', backOneLevel);
	document.getElementById('field-reset')?.addEventListener('click', () => {
		clearProgress();
		selectedSeed = null;
		search = '';
		if (searchInput) searchInput.value = '';
		replacePath([]);
	});

	window.addEventListener('popstate', (event) => {
		const fromState = event.state?.mapPath;
		path = validPath(Array.isArray(fromState) ? fromState : pathFromHash());
		const storedStack = event.state?.mapStack;
		mapPathHistory = Array.isArray(storedStack) ? storedStack.map((entry: string[]) => validPath(entry)) : [path];
		if (!mapPathHistory.length || mapPathHistory.at(-1)?.join('/') !== path.join('/')) mapPathHistory = [path];
		selectedSeed = null;
		render(true);
	});

	document.addEventListener('keydown', (event) => {
		if (event.key !== 'Escape') return;
		if (selectedSeed) {
			selectedSeed = null;
			if (seedDetail) seedDetail.hidden = true;
		} else if (searchInput?.value) {
			searchInput.value = '';
			search = '';
			render(false);
		} else if (path.length) {
			backOneLevel();
		}
	});

	document.addEventListener(PROGRESS_EVENT, () => render(false));
