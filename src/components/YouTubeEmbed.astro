---
interface Props {
	id: string;
	title: string;
}

const { id, title } = Astro.props;
const thumbnail = `https://i.ytimg.com/vi/${id}/maxresdefault.jpg`;
const embed = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0&modestbranding=1`;
---

<div class="embed" data-embed data-embed-src={embed}>
	<button
		class="embed-cover"
		type="button"
		aria-label={`Play: ${title}`}
		style={`--thumb: url('${thumbnail}')`}
	>
		<span class="embed-play" aria-hidden="true"></span>
	</button>
</div>

<script>
	document.querySelectorAll<HTMLElement>('[data-embed]').forEach((wrapper) => {
		const cover = wrapper.querySelector<HTMLButtonElement>('.embed-cover');
		if (!cover) return;
		cover.addEventListener('click', () => {
			const src = cover.parentElement?.dataset.embedSrc;
			if (!src) return;
			cover.dispatchEvent(new CustomEvent('video:play', { bubbles: true }));
			const frame = document.createElement('iframe');
			frame.src = src;
			frame.title = cover.getAttribute('aria-label') ?? 'Video player';
			frame.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
			frame.allowFullscreen = true;
			frame.classList.add('embed-frame');
			frame.setAttribute(
				'style',
				'position:absolute;inset:0;width:100%;height:100%;border:0;'
			);
			wrapper.replaceChildren(frame);
		});
	});
</script>

<style>
	.embed {
		position: relative;
		width: 100%;
		aspect-ratio: 16 / 9;
		background: #000;
		overflow: hidden;
	}

	.embed-cover {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		padding: 0;
		border: 0;
		cursor: pointer;
		background:
			linear-gradient(180deg, rgba(10, 8, 7, 0.04), rgba(10, 8, 7, 0.26)),
			var(--thumb, #111) center / cover no-repeat;
	}

	.embed-cover:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: -2px;
	}

	.embed-play {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
	}

	.embed-play::after {
		content: '';
		width: clamp(58px, 8vw, 78px);
		aspect-ratio: 1;
		border-radius: 50%;
		border: 1px solid rgba(251, 248, 243, 0.9);
		background: rgba(25, 21, 16, 0.42);
		transition:
			background-color 180ms ease,
			transform 180ms ease;
	}

	.embed-play::before {
		content: '';
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-38%, -50%);
		border-style: solid;
		border-width: 10px 0 10px 16px;
		border-color: transparent transparent transparent rgba(251, 248, 243, 0.92);
		z-index: 1;
	}

	.embed-cover:hover .embed-play::after {
		background: rgba(207, 116, 64, 0.55);
		transform: scale(1.05);
	}

	.embed-frame {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		border: 0;
	}
</style>