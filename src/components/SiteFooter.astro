---
interface Props {
	email: string;
	instagram: string;
	youtube: string;
}

const { email, instagram, youtube } = Astro.props;
---

<footer class="site-footer">
	<a href={`mailto:${email}`} aria-label={`Email ${email}`}>
		<svg viewBox="0 0 24 24" aria-hidden="true">
			<rect x="2.5" y="5" width="19" height="14" rx="2" />
			<path d="m3.5 7 8.5 6 8.5-6" />
		</svg>
	</a>
	<a href={instagram} target="_blank" rel="noreferrer" aria-label="Instagram">
		<svg viewBox="0 0 24 24" aria-hidden="true">
			<rect x="3.5" y="3.5" width="17" height="17" rx="5" />
			<circle cx="12" cy="12" r="4" />
			<circle class="fill" cx="17.4" cy="6.6" r="1.1" />
		</svg>
	</a>
	<a href={youtube} target="_blank" rel="noreferrer" aria-label="YouTube">
		<svg viewBox="0 0 24 24" aria-hidden="true">
			<rect x="2.5" y="5.5" width="19" height="13" rx="4" />
			<path class="fill" d="M10 9.2 15.2 12 10 14.8z" />
		</svg>
	</a>
</footer>

<style>
	.site-footer {
		display: flex;
		align-items: center;
		gap: 1.1rem;
		padding: clamp(12px, 1.8vw, 20px) clamp(16px, 3vw, 40px);
	}

	.site-footer a {
		display: block;
		line-height: 0;
		color: var(--soft);
		transition: color 160ms ease;
	}

	.site-footer a:hover {
		color: var(--ink);
	}

	.site-footer svg {
		width: 17px;
		height: 17px;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.4;
	}

	.site-footer .fill {
		fill: currentColor;
		stroke: none;
	}
</style>
