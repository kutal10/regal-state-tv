---
import QuoteCard from './QuoteCard.astro';
import { testimonialRows } from '../data/testimonials';

const rows = testimonialRows.map((items, index) => ({
	items,
	direction: index % 2 === 0 ? 'left' : 'right',
	duration: 64 + index * 14,
}));
---

<section class="marquee" aria-label="What people say about Regal State">
	{
		rows.map((row) => (
			<div class="marquee-row" data-direction={row.direction} style={`--duration:${row.duration}s`}>
				<div class="marquee-track">
					{[...row.items, ...row.items].map((testimonial, index) => (
						<div class="marquee-item" aria-hidden={index >= row.items.length ? 'true' : undefined}>
							<QuoteCard testimonial={testimonial} />
						</div>
					))}
				</div>
			</div>
		))
	}
</section>

<style>
	.marquee {
		--gap: clamp(10px, 1.2vw, 18px);
		display: grid;
		gap: var(--gap);
		width: 100%;
		overflow: hidden;
	}

	.marquee-row {
		overflow: hidden;
		-webkit-mask-image: linear-gradient(
			90deg,
			transparent 0,
			#000 6%,
			#000 94%,
			transparent 100%
		);
		mask-image: linear-gradient(90deg, transparent 0, #000 6%, #000 94%, transparent 100%);
	}

	.marquee-track {
		display: flex;
		width: max-content;
		animation: marquee-left var(--duration, 64s) linear infinite;
		will-change: transform;
	}

	.marquee-row[data-direction='right'] .marquee-track {
		animation-name: marquee-right;
		animation-delay: -12s;
	}

	.marquee-row:hover .marquee-track,
	.marquee-row:focus-within .marquee-track {
		animation-play-state: paused;
	}

	.marquee-item {
		flex: none;
		margin-right: var(--gap);
	}

	@keyframes marquee-left {
		from {
			transform: translateX(0);
		}
		to {
			transform: translateX(-50%);
		}
	}

	@keyframes marquee-right {
		from {
			transform: translateX(-50%);
		}
		to {
			transform: translateX(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.marquee-row {
			overflow-x: auto;
			-webkit-mask-image: none;
			mask-image: none;
			scrollbar-width: thin;
			scrollbar-color: var(--hairline) transparent;
		}

		.marquee-track {
			animation: none;
		}
	}
</style>
